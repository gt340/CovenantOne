    "zod": "^3.23.0",
    "libphonenumber-js": "^1.11.0",
    "@supabase/ssr": "^0.5.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
