# Copy to .env.local (never commit the real .env.local) and fill in real values.
# All values below are placeholders.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://platform_app:CHANGE_ME@localhost:5432/platform_dev?schema=public"
# Separate, more restricted connection string for read-heavy/report queries
# could be added later (DATABASE_URL_REPLICA) once we're at production scale.

# --- Supabase client (used by the Next.js app, e.g. app/api/health) ----------
# Safe to expose client-side (NEXT_PUBLIC_ prefix) — RLS is what makes the
# anon key safe to ship to the browser. Get both from: Supabase dashboard ->
# Project Settings -> API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="CHANGE_ME"
# Server-only — bypasses RLS entirely. NEVER prefix with NEXT_PUBLIC_, never
# send to the client, never commit.
SUPABASE_SERVICE_ROLE_KEY="CHANGE_ME"

# --- Phone verification SMS delivery -----------------------------------------
# No real SMS provider is wired up yet (see src/lib/domain/sms-provider.ts).
# In NODE_ENV=development, OTP codes are logged server-side and returned in
# the API response instead of being texted, so the flow can be tested
# without a provider. Outside development, phone verification will fail
# loudly until a real provider (e.g. Twilio) is integrated there.
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""

# TEMPORARY TESTING ONLY — set to "true" to let phone verification work on a
# real deployment (e.g. Vercel) without a real SMS provider, by returning the
# OTP code directly in the API response instead of texting it. This provides
# NO real proof of phone ownership. Remove this var entirely once a real SMS
# provider is wired up, and before any real member could reach this flow.
# ALLOW_INSECURE_OTP_TESTING_BYPASS="true"

# --- Auth --------------------------------------------------------------------
# Used to sign session tokens (JWT) — generate with `openssl rand -base64 48`
AUTH_SESSION_SECRET="CHANGE_ME"
# Argon2id parameters (tune for your infra; these are conservative defaults)
AUTH_ARGON2_MEMORY_COST_KB="19456"
AUTH_ARGON2_TIME_COST="2"
AUTH_ARGON2_PARALLELISM="1"

# --- OAuth (Google sign-in, wired up in app/login and app/signup) -------------
# IMPORTANT: these are NOT read by this app at runtime. Supabase Auth handles
# the OAuth exchange itself, so the Client ID/Secret must be entered directly
# in the Supabase dashboard: Authentication -> Providers -> Google. The two
# lines below exist only as a reminder of what you'll need to have on hand
# when you set that up (from Google Cloud Console -> APIs & Services ->
# Credentials -> OAuth client ID). Authorized redirect URI to register with
# Google: https://YOUR_PROJECT_REF.supabase.co/auth/v1/callback
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APPLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_CLIENT_SECRET=""

# --- Field-level encryption (messages, documents) -----------------------------
# KMS key id / reference used to wrap per-conversation data encryption keys.
# Never store the raw master key in this file in real environments — this is
# a reference to a secret manager entry (e.g. AWS KMS key ARN, GCP KMS key path).
MESSAGE_ENCRYPTION_KMS_KEY_REF="CHANGE_ME"

# --- Object storage (photos, ID documents, voice messages) -------------------
OBJECT_STORAGE_BUCKET="CHANGE_ME"
OBJECT_STORAGE_REGION="CHANGE_ME"

# --- Third-party identity verification (Phase-dependent) ----------------------
IDENTITY_VERIFICATION_PROVIDER_API_KEY=""

# --- Seed script safety guard (see prisma/seed.ts) ----------------------------
NODE_ENV="development"
SEED_CONFIRM=""

