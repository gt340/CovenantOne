# Copy to .env.local (never commit the real .env.local) and fill in real values.
# All values below are placeholders.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://platform_app:CHANGE_ME@localhost:5432/platform_dev?schema=public"
# Separate, more restricted connection string for read-heavy/report queries
# could be added later (DATABASE_URL_REPLICA) once we're at production scale.

# --- Auth --------------------------------------------------------------------
# Used to sign session tokens (JWT) — generate with `openssl rand -base64 48`
AUTH_SESSION_SECRET="CHANGE_ME"
# Argon2id parameters (tune for your infra; these are conservative defaults)
AUTH_ARGON2_MEMORY_COST_KB="19456"
AUTH_ARGON2_TIME_COST="2"
AUTH_ARGON2_PARALLELISM="1"

# --- OAuth (optional, Phase 2+) ----------------------------------------------
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
APPLE_OAUTH_CLIENT_ID=""
APPLE_OAUTH_CLIENT_SECRET=""

# --- Field-level encryption (messages, documents) -----------------------------
# KMS key id / reference used to wrap per-conversation data encryption keys.
# Never store the raw master key in this file in real environments — this is
# a reference to a secret manager entry (e.g. AWS KMS key ARN, GCP KMS key path).
MESSAGE_ENCRYPTION_KMS_KEY_REF="CHANGE_ME"

# --- Object storage (photos, ID documents, voice messages) -------------------
OBJECT_STORAGE_BUCKET="CHANGE_ME"
OBJECT_STORAGE_REGION="CHANGE_ME"

# --- Third-party identity verification (Phase-dependent) ----------------------
IDENTITY_VERIFICATION_PROVIDER_API_KEY=""

# --- Seed script safety guard (see prisma/seed.ts) ----------------------------
NODE_ENV="development"
SEED_CONFIRM=""
